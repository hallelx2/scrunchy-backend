# ============================================
# Scrunchy Backend - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ============================================
# DATABASE CONFIGURATION (Neon Serverless PostgreSQL)
# ============================================
# Get your connection string from: https://console.neon.tech
# Format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Example: postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/scrunchy?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/scrunchy?sslmode=require

# Neon Direct URL (for migrations)
# Get from Neon dashboard -> Connection Details -> Direct connection
DIRECT_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/scrunchy?sslmode=require

# ============================================
# REDIS CONFIGURATION (Cloud Redis)
# ============================================
# Option 1: Upstash Redis (Recommended - Free tier available)
# Get from: https://console.upstash.com
# Format: redis://default:PASSWORD@HOST:PORT
# Example: redis://default:AbCd1234@usw1-xxx.upstash.io:6379
REDIS_URL=redis://default:YOUR_PASSWORD@YOUR_ENDPOINT.upstash.io:6379

# Option 2: Redis Cloud
# Format: redis://:PASSWORD@HOST:PORT
# Example: redis://:password@redis-12345.c1.us-east-1-1.ec2.cloud.redislabs.com:12345

# Option 3: Local Redis (for development)
# REDIS_URL=redis://localhost:6379

# ============================================
# SOLANA BLOCKCHAIN CONFIGURATION
# ============================================
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Program IDs from deployed contracts (devnet)
ASSET_REGISTRY_PROGRAM_ID=7vxpftgcdbh6NW77uAGVxp4aM2RcbQtmeGixNp2ifCDn
MARKETPLACE_PROGRAM_ID=G46EH6LskmJpBTvZNewSL4Xe5fkdbcdkMpRM8wQ9T3RH
ACCESS_CONTROL_PROGRAM_ID=n41USxoi9Lf1RyZUVAfCHD5TSeuDBuqDxEpUHzkDqf2

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
# Generate with: openssl rand -base64 32
JWT_SECRET=scrunchy-dev-secret-key-change-in-production-min-32-characters-long
JWT_EXPIRY=7d

# ============================================
# PLATFORM CONFIGURATION
# ============================================
# Your Solana wallet address (receives platform fees)
PLATFORM_TREASURY=YOUR_PLATFORM_TREASURY_WALLET_ADDRESS
PLATFORM_FEE_BPS=250

# ============================================
# IPFS STORAGE (Pinata)
# ============================================
# Get API keys from: https://app.pinata.cloud/developers/api-keys
PINATA_API_KEY=YOUR_PINATA_API_KEY
PINATA_SECRET=YOUR_PINATA_SECRET_KEY

# ============================================
# AWS S3 CONFIGURATION (Optional - Backup storage)
# ============================================
# Only needed if you want S3 as backup to IPFS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# ============================================
# MONITORING & LOGGING (Optional)
# ============================================
SENTRY_DSN=

# ============================================
# DEVELOPMENT ONLY
# ============================================
DEBUG=false
